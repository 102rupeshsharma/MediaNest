{
  "name": "fotoowl-media-assignment",
  "version": "1.0.0",
  "description": "Headless Media SDK + Component Library Monorepo",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter web-app dev",
    "build": "pnpm -r build",
    "lint": "eslint \"{apps,packages}/**/*.{ts,tsx}\"",
    "format": "prettier --write \"{apps,packages,skills}/**/*.{ts,tsx,json,md}\"",
    "docs:sdk": "typedoc && typedoc --plugin typedoc-plugin-markdown --out sdk-docs-markdown",
    "docs:sdk:watch": "typedoc --watch",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "8",
    "@storybook/react": "^8.6.18",
    "@storybook/react-vite": "^8.6.18",
    "@types/node": "^26.2.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.56.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "prettier": "^3.2.5",
    "storybook": "^8.6.18",
    "tsx": "^4.23.11",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.12.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "^18.3.31",
      "@types/react-dom": "^18.3.7"
    }
  }
}